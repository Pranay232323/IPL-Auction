# =============================================================================
# IPL MEGA AUCTION MULTIPLAYER — ENVIRONMENT CONFIGURATION
# Copy this file to `.env` before running locally:  cp .env.example .env
# =============================================================================

# Server Configuration
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
CLIENT_ORIGIN=*

# SQLite Persistence
DATABASE_PATH=./data/ipl_auction.db

# Authentication (Change JWT_SECRET to a strong 32+ char random string in production!)
JWT_SECRET=change-this-super-secret-ipl-auction-jwt-key-2026
JWT_EXPIRES_IN=7d

# LiveKit Voice Communication (Primary SFU Provider)
# Obtain free keys at https://cloud.livekit.io or run local `livekit-server --dev`.
# When all three values below are populated, rooms automatically use LiveKit SFU.
# When left blank, the server honestly reports `livekitConfigured: false` and
# activates the built-in WebRTC P2P Audio Mesh over Socket.IO signaling so
# up to 10 players still get live browser voice calls out of the box for free.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# WebRTC STUN/TURN Servers (JSON array string, optional override for P2P fallback)
WEBRTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"stun:stun1.l.google.com:19302"}]

# Optional AI Pundit Narrative Enhancement (OpenAI-compatible endpoint)
# Note: The deterministic Cricket Analytics & Optimal XI Engine works 100% locally
# without any external API key. Setting OPENAI_API_KEY optionally appends AI pundit prose.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
