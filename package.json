{
  "name": "ipl-mega-auction-multiplayer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Real-Time 10-Player Multiplayer IPL Mega Auction Game with Socket.IO, LiveKit Voice + WebRTC Fallback, SQLite Persistence, 540+ Real IPL Players, and Post-Auction AI Team Ranking Engine",
  "scripts": {
    "dev": "concurrently -n SERVER,CLIENT -c cyan,yellow \"tsx watch server/src/index.ts\" \"vite --config vite.config.ts\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite --config vite.config.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --config vite.config.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "db:migrate": "tsx server/src/db/cli-migrate.ts",
    "db:seed": "tsx server/src/db/cli-seed.ts",
    "db:reset": "tsx server/src/db/cli-migrate.ts --reset && tsx server/src/db/cli-seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "livekit-client": "^2.9.1",
    "livekit-server-sdk": "^2.9.7",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "uuid": "^11.0.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.3",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.1",
    "vitest": "^3.0.6"
  }
}
